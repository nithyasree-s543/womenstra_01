# Frontend Environment Configuration for Vercel / Local Vite Dev

# Base URL pointing to the backend Render server (fallback: http://localhost:5000)
# Example for production: https://womenstra-api.onrender.com
VITE_API_URL=http://localhost:5000

# STUN / TURN credentials for WebRTC video & voice calls
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
