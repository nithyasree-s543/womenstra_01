# ===================================================
# 💜 WOMENTRA ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (CORS whitelist - set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret (change to a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_2026_change_me

# Google Gemini AI API (Used for Womentra Didi voice intelligence, scheme eligibility & simplification)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# WebRTC TURN Server (Optional - for calls behind strict NAT/firewalls)
# Get free credentials at: https://www.metered.ca/tools/openrelay/
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Razorpay Test Mode Payment Gateway
RAZORPAY_KEY_ID=rzp_test_womentra_key_id
RAZORPAY_KEY_SECRET=rzp_test_womentra_key_secret

# SMS Gateway (Optional in production: CDAC / Twilio / Gupshup / MSG91)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=WOMENT

# DigiLocker / UIDAI e-KYC Sandbox (Optional in production)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# ─── SECURITY NOTES ─────────────────────────────────
# - NEVER store raw Aadhaar numbers. Use masked versions only.
# - All secrets must be in .env and NEVER committed to git.
# - .env.example is safe to commit (contains no real secrets).
# - In production: use a secrets manager (GCP Secret Manager / AWS Secrets Manager).
