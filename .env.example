# ===================================================
# 💜 WOMENTRA ENVIRONMENT CONFIGURATION
# ===================================================

# ─── BACKEND / SERVER CONFIGURATION (Render / Node) ───
PORT=5000
NODE_ENV=development

# Allowed Client URLs (CORS whitelist & Socket.IO - comma-separated list of origins)
# For production on Vercel: e.g., https://womenstra.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://localhost:4173

# JWT Authentication Secret (change to a long random string in production)
JWT_SECRET=womentra_secure_production_jwt_secret_key_change_me_2026

# Google Gemini AI API (Used for Womentra Didi voice intelligence, navigation & NLP)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── FRONTEND / CLIENT CONFIGURATION (Vercel / Vite) ───
# Backend API & Socket.IO URL for client requests (fallback: http://localhost:5000)
# In production on Vercel, set this to your Render server URL (e.g., https://womenstra-server.onrender.com)
VITE_API_URL=http://localhost:5000

# WebRTC STUN / TURN Server Configuration (Optional - for calls behind strict NAT/firewalls)
# Free TURN credentials available at: https://www.metered.ca/tools/openrelay/
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Razorpay Test Mode Payment Gateway
RAZORPAY_KEY_ID=rzp_test_womentra_key_id
RAZORPAY_KEY_SECRET=rzp_test_womentra_key_secret

# SMS Gateway (Optional in production: CDAC / Twilio / Gupshup / MSG91)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=WOMENT

# DigiLocker / UIDAI e-KYC Sandbox (Optional in production)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# ─── SECURITY NOTES ─────────────────────────────────
# - In production (Render + Vercel):
#   * On Render: set PORT, NODE_ENV=production, CLIENT_URL (your Vercel app domain), JWT_SECRET, GEMINI_API_KEY
#   * On Vercel: set VITE_API_URL (your Render app URL), plus any VITE_TURN_* keys
# - Live SQLite / db.json files are automatically seeded on first launch.
# - All secrets must remain in environment variables and NEVER committed to git.
